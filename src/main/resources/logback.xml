<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志落盘目录由 com.aqishi.toolbox.util.Logging#bootstrap() 在 Main 启动时算出并写入
  系统属性 java.toolbox.logDir。这里的默认值只在未引导（如直接跑单测）时兜底。
-->
<configuration>
    <property name="LOG_DIR" value="${java.toolbox.logDir:-${java.io.tmpdir}/java-toolbox-logs}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/toolbox.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/toolbox.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 第三方客户端库默认只留 WARN，避免刷屏淹没应用自身日志 -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.apache.zookeeper" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.jitsi" level="WARN"/>
    <logger name="com.jcraft.jsch" level="WARN"/>
    <logger name="redis.clients" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
